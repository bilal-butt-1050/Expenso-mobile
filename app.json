{
  "expo": {
    "name": "Expenso",
    "slug": "expenso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.jpg",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F19",
    "splash": {
      "image": "./assets/transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19",
      "dark": {
        "image": "./assets/transparent.png",
        "backgroundColor": "#0B0F19"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#0B0F19",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#0B0F19",
      "barStyle": "light-content"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.expenso.app",
      "userInterfaceStyle": "dark"
    },
    "android": {
      "package": "com.expenso.app",
      "userInterfaceStyle": "dark",
      "splash": {
        "image": "./assets/transparent.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B0F19",
        "dark": {
          "image": "./assets/transparent.png",
          "backgroundColor": "#0B0F19"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.jpg",
        "backgroundColor": "#0B0F19"
      }
    },
    "extra": {
      "apiUrl": "https://expenso-backend-icj0.onrender.com",
      "eas": {
        "projectId": "d196b589-e7ca-491b-b05a-3ba0c3f16433"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/transparent.png",
          "imageWidth": 200,
          "backgroundColor": "#0B0F19",
          "dark": {
            "image": "./assets/transparent.png",
            "backgroundColor": "#0B0F19"
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d196b589-e7ca-491b-b05a-3ba0c3f16433"
    }
  }
}
