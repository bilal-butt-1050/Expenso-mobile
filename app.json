{
  "expo": {
    "name": "Expenso",
    "slug": "expenso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.jpg",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F19",
    "splash": {
      "image": "./assets/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F19",
      "dark": {
        "image": "./assets/logo.jpg",
        "backgroundColor": "#0B0F19",
        "resizeMode": "contain"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#0B0F19",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#0B0F19",
      "barStyle": "light-content"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.expenso.app",
      "userInterfaceStyle": "dark"
    },
    "android": {
      "package": "com.expenso.app",
      "userInterfaceStyle": "dark",
      "splash": {
        "image": "./assets/logo.jpg",
        "resizeMode": "contain",
        "backgroundColor": "#0B0F19",
        "dark": {
          "image": "./assets/logo.jpg",
          "backgroundColor": "#0B0F19",
          "resizeMode": "contain"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F19"
      }
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F19",
          "image": "./assets/logo.jpg",
          "dark": {
            "image": "./assets/logo.jpg",
            "backgroundColor": "#0B0F19"
          },
          "imageWidth": 200
        }
      ]
    ]
  }
}
